# Local development database settings. These are defaults, not production secrets.
DB_NAME=ledger
DB_USERNAME=ledger
DB_PASSWORD=ledger
DB_HOST=localhost
DB_PORT=5432

# JWT_SECRET must be Base64-encoded and decode to at least 32 bytes.
# Generate your own — do not reuse a value from this file or any other setup:
#   openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRATION_MS=3600000